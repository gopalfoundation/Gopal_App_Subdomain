# Server-only. Copy to ignored .env.local for local use. Never use PUBLIC_ prefixes.
SITE_ORIGIN=http://127.0.0.1:4321
REGISTRATION_BACKEND_URL=
REGISTRATION_BACKEND_SECRET=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Production: these four private values live in Secret Manager JSON secret
# SITARAM_SERVER_CONFIG, bound only to programsApp. The production origin is fixed.
# Nonsecret parameter: confirmed private bucket in the existing Firebase project.
CMS_BUCKET=
# GitHub variable FIREBASE_PROJECT_ID; secret FIREBASE_SERVICE_ACCOUNT_GLORY_OF_PEACE.
