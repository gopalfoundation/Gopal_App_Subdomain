---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/ram.css';
import content from '../../../../public/content/ram.json';
export function getStaticPaths() {
  return content.articles.filter(a => a.published).map(article => ({params:{slug:article.slug},props:{article}}));
}
const { article } = Astro.props;
---
<BaseLayout title={article.seoTitle || article.title} description={article.seoDescription || article.excerpt}>
  <div class="ram-page"><section class="ram-section"><div class="container"><article class="ram-detail" data-ram-detail data-ram-record-slug={article.slug}><a class="ram-text-link" href="/ram/">Back to RAM</a><h1>{article.title}</h1><img src={article.image || '/images/hero-riverside-diya.png'} alt={article.imageAlt} /><p>{article.body}</p></article></div></section></div>
  <script>import { initRamDetail } from '../../../lib/ram/page.mjs'; initRamDetail('article');</script>
</BaseLayout>
