---
import BaseLayout from '../layouts/BaseLayout.astro';
import InitiativeCard from '../components/InitiativeCard.astro';
import {featuredMarkup} from '../lib/website/model.mjs';
import website from '../../public/content/website.json';
const home = website.home;
const featuredInitiatives = website.initiativesPage.cards.filter((item) => item.enabled && item.featured);
---
<BaseLayout title={home.seoTitle} description={home.seoDescription}>
  <section class="hero" data-home-hero style={`--hero-image: url(${home.image});`}>
    <div class="container hero__inner"><div class="hero__content">
      <div class="eyebrow" data-website-text="home.eyebrow">{home.eyebrow}</div>
      <h1 data-website-text="home.headline">{home.headline}</h1>
      <p class="lede" data-website-text="home.description">{home.description}</p>
      <div class="actions">
        <a class="button button--primary" href={home.primaryCta.href} data-website-href="home.primaryCta.href" data-website-text="home.primaryCta.label" hidden={!home.primaryCta.enabled}>{home.primaryCta.label}</a>
        <a class="button" href={home.secondaryCta.href} data-website-href="home.secondaryCta.href" data-website-text="home.secondaryCta.label" hidden={!home.secondaryCta.enabled}>{home.secondaryCta.label}</a>
      </div>
    </div></div>
  </section>
  <div class="home-sections">
  <section class="section section--cream" data-home-section="initiatives" aria-labelledby="initiatives-heading">
    <div class="container">
      <div class="section__intro">
        <h2 id="initiatives-heading" data-website-text="home.initiativesHeading">{home.initiativesHeading}</h2>
        <p data-website-text="home.initiativesIntro">{home.initiativesIntro}</p>
        <div class="lotus-rule" aria-hidden="true"></div>
      </div>
      <div class="initiative-grid" data-website-cards="home">
        {featuredInitiatives.map((initiative) => <InitiativeCard {...initiative} />)}
      </div>
    </div>
  </section>

  <section class="section" data-home-section="about" aria-labelledby="about-heading">
    <div class="container split">
      <div>
        <h2 id="about-heading" data-website-text="home.aboutHeading">{home.aboutHeading}</h2>
        <p class="lede" data-website-text="home.aboutSummary">{home.aboutSummary}</p>
        <p style="margin-top: 18px; color: var(--ink-soft);" data-website-text="home.aboutRelated">{home.aboutRelated}</p>
        <div class="actions">
          <a class="button" href="/about">Learn More About GOPAL Foundation</a>
        </div>
      </div>
      <div class="logo-pair" aria-label="Organizational relationship">
        <div class="logo-panel">
          <img src={website.site.logo} data-website-image="site.logo" alt="GOPAL Foundation logo" width="300" height="300" />
        </div>
        <div class="logo-panel">
          <img src={home.aboutImage} data-website-image="home.aboutImage" alt="Bhaktisaurabh logo" width="320" height="320" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream" data-home-section="values" aria-labelledby="why-heading">
    <div class="container">
      <div class="section__intro">
        <h2 id="why-heading" data-website-text="home.valuesHeading">{home.valuesHeading}</h2>
      </div>
      <div class="feature-row">
        <div class="feature">
          <span class="feature__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24"><path d="M4 19c2-5 6-8 12-9 0 6-3 10-9 12 1-6 4-10 9-12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <div>
            <h3 data-website-text="home.values.0.title">{home.values[0].title}</h3>
            <p data-website-text="home.values.0.description">{home.values[0].description}</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9-10a5 5 0 0 1 9-4 5 5 0 0 1 9 4c-2 5.5-9 10-9 10Z" fill="currentColor"/></svg>
          </span>
          <div>
            <h3 data-website-text="home.values.1.title">{home.values[1].title}</h3>
            <p data-website-text="home.values.1.description">{home.values[1].description}</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24"><path d="M7 11a4 4 0 1 1 8 0v8H7v-8Zm8 8h2a3 3 0 0 0 3-3v-3a3 3 0 0 0-3-3h-1M7 19H5a3 3 0 0 1-3-3v-3a3 3 0 0 1 3-3h1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <div>
            <h3 data-website-text="home.values.2.title">{home.values[2].title}</h3>
            <p data-website-text="home.values.2.description">{home.values[2].description}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-home-section="featured" aria-labelledby="featured-programs-heading">
    <div class="container">
      <div class="section__intro">
        <h2 id="featured-programs-heading" data-website-text="home.featuredHeading">{home.featuredHeading}</h2>
        <p data-website-text="home.featuredIntro">{home.featuredIntro}</p>
      </div>
      <div class="content-grid" data-website-featured set:html={featuredMarkup(website)} />
    </div>
  </section>
  </div>
</BaseLayout>
