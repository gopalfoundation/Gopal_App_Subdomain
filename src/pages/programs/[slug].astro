---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('programs');
  return entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id.replace(/\.md$/, '') }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'programs'> };
const { entry } = Astro.props as Props;
const { Content } = await entry.render();
---
<BaseLayout title={`${entry.data.title} | SITA RAM Initiatives`} description={entry.data.description}>
  <section class="page-hero" data-program-page data-program-title={entry.data.title} data-program-id={entry.data.slug ?? entry.id.replace(/\.md$/, '')}><div class="container page-hero__inner"><p class="eyebrow">{entry.data.initiative}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p></div></section>
  <section class="section"><div class="container prose"><Content /></div></section>
  <section class="section section--cream" data-inline-rsvp-section hidden>
    <div class="container" data-inline-rsvp></div>
  </section>
</BaseLayout>
