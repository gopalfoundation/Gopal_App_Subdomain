---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | SITA RAM Initiatives" description="The page could not be found.">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <h1>Page Not Found</h1>
      <p class="lede">The page may have moved or the address may be incorrect.</p>
      <div class="actions">
        <a class="button button--primary" href="/">Return Home</a>
        <a class="button" href="/programs">Explore Programs</a>
        <a class="button" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
