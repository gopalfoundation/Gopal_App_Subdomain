---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import website from '../../public/content/website.json';
import {organizationSchema} from '../lib/website/model.mjs';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  socialTitle?: string;
  socialDescription?: string;
  socialImage?: string;
  indexable?: boolean;
}

const {
  title = website.seo.defaultTitle,
  description = website.seo.description
} = Astro.props;
const canonical = Astro.props.canonicalUrl || new URL(Astro.url.pathname, 'https://programs.gloryofpeaceandlove.org').toString();
const genericTitle = !/^\/(ram|sita)(\/|$)/.test(Astro.url.pathname) && !['/', '/programs', '/programs/'].includes(Astro.url.pathname);
const titleBase = genericTitle && Astro.props.title ? title.split(' | ')[0] : '';
const effectiveTitle = titleBase ? website.seo.titlePattern.replace('{title}', titleBase) : title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-website-title={titleBase || (!Astro.props.title ? 'default' : undefined)}>{effectiveTitle}</title>
    <meta name="description" content={description} data-website-default-description={!Astro.props.description || undefined} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" data-website-favicon href={website.site.favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={Astro.props.socialTitle || effectiveTitle} />
    <meta property="og:description" content={Astro.props.socialDescription || description} data-website-default-description={!Astro.props.description && !Astro.props.socialDescription || undefined} />
    {Astro.props.socialImage && <meta property="og:image" content={new URL(Astro.props.socialImage, canonical).toString()} />}
    {!Astro.props.socialImage && website.seo.socialImage && <meta property="og:image" data-website-default-social content={new URL(website.seo.socialImage,canonical).toString()} />}
    <meta name="robots" data-website-robots={Astro.props.indexable !== false || undefined} content={Astro.props.indexable === false ? 'noindex, nofollow' : website.seo.robots} />
    {website.seo.verification && <meta name="google-site-verification" content={website.seo.verification} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" data-website-schema set:html={organizationSchema(website)} />
    <script is:inline src="/scripts/site-overrides.js" defer></script>
    <script>import '../lib/website/public.mjs';</script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
